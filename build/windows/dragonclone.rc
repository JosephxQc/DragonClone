// Windows resources: icon, manifest and version info.
// Rebuild with: x86_64-w64-mingw32-windres build/windows/dragonclone.rc -O coff -o rsrc_windows_amd64.syso
#include <winver.h>

1 ICON "icon.ico"
1 24 "dragonclone.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "DragonClone - disk cloning, imaging and restore"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "DragonClone"
      VALUE "OriginalFilename", "DragonClone.exe"
      VALUE "ProductName", "DragonClone"
      VALUE "ProductVersion", "1.0.0"
      VALUE "LegalCopyright", "MIT License"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
